# CP_CONFIG selects which Python configuration file the application loads.
#
# Allowed values:
#   smoke - runs the small smoke-test configuration from src/config_smoke.py.
#           This is the recommended default for first-time Docker users because
#           it uses fewer calibration/testing episodes and should fail faster if
#           dependencies, model files, or Grid2Op data are missing.
#   full  - runs the normal experiment configuration from src/config_full.py.
#           This can take much longer (up to 3h) and use more CPU/memory.
#
# Docker Compose also defaults to "smoke" if this variable is not set.
CP_CONFIG=smoke

# OMP_NUM_THREADS controls how many CPU threads OpenMP-based numerical
# libraries may use inside each Python worker process.
#
# This project already uses multiprocessing for calibration, model training,
# and testing. If every worker also starts many OpenMP threads, the container
# can create too many CPU threads and become slower or unstable.
#
# Keep this at 1 unless you are deliberately tuning performance on a machine
# with enough CPU cores and memory.
OMP_NUM_THREADS=1

# CUDA_VISIBLE_DEVICES controls whether CUDA-capable GPUs are visible to
# libraries such as TensorFlow.
#
# -1 means "hide GPUs and run CPU-only". This is the safest Docker default
# because the image is not configured for NVIDIA GPU passthrough.
#
# Change this only if you intentionally extend the Docker setup for GPU support.
CUDA_VISIBLE_DEVICES=-1
